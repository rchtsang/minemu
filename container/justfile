set shell := ["bash", "-eu", "-o", "pipefail", "-c"]

workspace := parent_directory(justfile_directory())
container := justfile_directory()
dockerfile := justfile_directory() / "Dockerfile"
docker := env_var_or_default("DOCKER", "docker")
image := env_var_or_default("IMAGE", "minemu-dev:local")
repository := env_var_or_default("REPOSITORY", "rtsang1/cs492-stevens")
buildx_builder := env_var_or_default("BUILDX_BUILDER", "minemu-multiarch")
dev_uid := `uid="$(id -u)"; if [ "$uid" -eq 0 ]; then printf 1000; else printf %s "$uid"; fi`

# Build the lightweight student image.
build:
    {{ docker }} build \
      --file "{{ dockerfile }}" \
      --target student \
      --build-arg DEV_UID="{{ dev_uid }}" \
      --tag "{{ image }}" \
      "{{ workspace }}"

# Rebuild the student image without cached layers.
rebuild:
    {{ docker }} build \
      --file "{{ dockerfile }}" \
      --target student \
      --no-cache \
      --build-arg DEV_UID="{{ dev_uid }}" \
      --tag "{{ image }}" \
      "{{ workspace }}"

# Create or select the reusable multi-platform Buildx builder.
buildx-builder:
    @if {{ docker }} buildx inspect "{{ buildx_builder }}" >/dev/null 2>&1; then \
      {{ docker }} buildx use "{{ buildx_builder }}"; \
    else \
      {{ docker }} buildx create \
        --name "{{ buildx_builder }}" \
        --driver docker-container \
        --use; \
    fi
    {{ docker }} buildx inspect "{{ buildx_builder }}" --bootstrap

# Build and push one architecture-specific version tag on its native host.
publish-platform platform: buildx-builder
    #!/usr/bin/env bash
    set -euo pipefail
    case "{{ platform }}" in
      amd64|arm64) ;;
      *) printf 'unsupported platform: %s (expected amd64 or arm64)\n' "{{ platform }}" >&2; exit 2 ;;
    esac
    version="$(cargo metadata --manifest-path "{{ workspace }}/Cargo.toml" --no-deps --format-version 1 | jq -er '.packages[] | select(.name == "minemu") | .version')"
    tag="{{ repository }}:${version}-{{ platform }}"
    {{ docker }} buildx build \
      --builder "{{ buildx_builder }}" \
      --platform "linux/{{ platform }}" \
      --file "{{ dockerfile }}" \
      --target student \
      --tag "${tag}" \
      --provenance=mode=max \
      --sbom=true \
      --push \
      "{{ workspace }}"
    {{ docker }} buildx imagetools inspect "${tag}"

# Combine the pushed architecture tags into the workspace version tag.
publish:
    #!/usr/bin/env bash
    set -euo pipefail
    version="$(cargo metadata --manifest-path "{{ workspace }}/Cargo.toml" --no-deps --format-version 1 | jq -er '.packages[] | select(.name == "minemu") | .version')"
    {{ docker }} buildx imagetools inspect "{{ repository }}:${version}-amd64"
    {{ docker }} buildx imagetools inspect "{{ repository }}:${version}-arm64"
    {{ docker }} buildx imagetools create \
      --tag "{{ repository }}:${version}" \
      "{{ repository }}:${version}-amd64" \
      "{{ repository }}:${version}-arm64"
    {{ docker }} buildx imagetools inspect "{{ repository }}:${version}"

# Check the installed student tools.
smoke: build
    {{ docker }} run --rm "{{ image }}" /opt/minemu/container/smoke.sh

# Open a non-root shell with the repository mounted.
shell: build
    {{ docker }} run --rm --interactive --tty \
      --add-host host.docker.internal:host-gateway \
      --volume "{{ workspace }}:/workspace:Z" \
      --workdir /workspace \
      "{{ image }}"

# Remove locally built images and container build artifacts.
clean:
    -{{ docker }} image rm "{{ image }}"
    rm -rf "{{ container }}/build"
