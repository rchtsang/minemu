set shell := ["zsh", "-eu", "-o", "pipefail", "-c"]

workspace := parent_directory(justfile_directory())
dockerfile := justfile_directory() / "Dockerfile"
docker := env_var_or_default("DOCKER", "docker")
image := env_var_or_default("IMAGE", "minemu-dev:local")
dev_uid := `uid="$(id -u)"; if [ "$uid" -eq 0 ]; then printf 1000; else printf %s "$uid"; fi`

# Build the lightweight student image.
build:
    {{ docker }} build \
      --file "{{ dockerfile }}" \
      --target student \
      --build-arg DEV_UID="{{ dev_uid }}" \
      --tag "{{ image }}" \
      "{{ workspace }}"

# Rebuild the student image without cached layers.
rebuild:
    {{ docker }} build \
      --file "{{ dockerfile }}" \
      --target student \
      --no-cache \
      --build-arg DEV_UID="{{ dev_uid }}" \
      --tag "{{ image }}" \
      "{{ workspace }}"

# Check the installed student tools.
smoke: build
    {{ docker }} run --rm "{{ image }}" /opt/minemu/container/smoke.sh

# Open a non-root shell with the repository mounted.
shell: build
    {{ docker }} run --rm --interactive --tty \
      --add-host host.docker.internal:host-gateway \
      --volume "{{ workspace }}:/workspace:Z" \
      --workdir /workspace \
      "{{ image }}"

# Remove locally built images.
clean:
    -{{ docker }} image rm "{{ image }}"
